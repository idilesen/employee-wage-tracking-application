@page
@model ContactModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>EWTA - Contact</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f0f2f5; margin: 0; }
        .header { background-color: #f8f9fa; color: #002244; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd; }
        .header h1 { margin: 0; font-size: 18px; font-weight: 600; }
        .navbar { background-color: #003366; border-bottom: 4px solid #cc0000; display: flex; padding: 0 20px; }
        .navbar ul { list-style: none; margin: 0; padding: 0; display: flex; width: 100%; }
        .navbar li a { display: block; color: white; padding: 12px 25px; text-decoration: none; font-weight: bold; font-size: 13px; transition: 0.3s; }
        .navbar li a:hover, .navbar li a.active { background-color: #cc0000; color: white; }
        .logout-item { margin-left: auto; }
        .container { max-width: 800px; margin: 40px auto; padding: 0 20px; }
        .card { background: white; padding: 36px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 24px; }
        h2 { color: #003366; border-bottom: 2px solid #cc0000; padding-bottom: 10px; margin-bottom: 20px; }
        .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .contact-item { display: flex; align-items: flex-start; gap: 12px; padding: 16px; background: #f0f4ff; border-radius: 6px; }
        .contact-item .icon { font-size: 24px; }
        .contact-item .info h4 { margin: 0 0 4px; color: #003366; font-size: 14px; }
        .contact-item .info p { margin: 0; color: #555; font-size: 13px; }
        .contact-item .info a { color: #003366; text-decoration: none; }
        .form-group { margin-bottom: 14px; }
        label { display: block; font-weight: bold; margin-bottom: 4px; font-size: 13px; color: #333; }
        input[type=text], input[type=email], textarea { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-size: 13px; font-family: Arial, sans-serif; }
        textarea { height: 100px; resize: vertical; }
        .btn-send { background: #003366; color: white; padding: 10px 28px; border: none; border-radius: 4px; font-size: 14px; cursor: pointer; }
        .msg { padding: 10px; border-radius: 4px; margin-top: 12px; background: #d4edda; color: #155724; }
    </style>
</head>
<body>
<div class="header"><h1>Employee Wages Tracking Application (EWTA)</h1></div>
<nav class="navbar">
    <ul>
        <li><a href="/Index">HOME</a></li>
        <li><a href="/Index?category=Forms">FORMS</a></li>
        <li><a href="/Index?category=Reports">REPORTS</a></li>
        <li><a href="/About">ABOUT</a></li>
        <li><a href="/Contact" class="active">CONTACT</a></li>
        <li><a href="/Help">HELP</a></li>
        <li class="logout-item"><a href="/Login">LOGOUT</a></li>
    </ul>
</nav>
<div class="container">
    <div class="card">
        <h2>Contact Information</h2>
        <div class="contact-grid">
            <div class="contact-item"><div class="icon">🏛️</div><div class="info"><h4>University</h4><p>Atlas University<br>Faculty of Engineering and Nature Sciences</p></div></div>
            <div class="contact-item"><div class="icon">👨‍🏫</div><div class="info"><h4>Instructor</h4><p>Asst. Prof. Mustafa Coruh<br><a href="mailto:mcoruh@gmail.com">mcoruh@gmail.com</a></p></div></div>
            <div class="contact-item"><div class="icon">📞</div><div class="info"><h4>Technical Support</h4><p>111 222 3333</p></div></div>
            <div class="contact-item"><div class="icon">🌐</div><div class="info"><h4>Reference Project</h4><p><a href="#">mustafacoruh.com/WEBDers</a></p></div></div>
        </div>
    </div>
    <div class="card">
        <h2>Send a Message</h2>
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-group"><label>Your Name</label><input type="text" name="Name" required /></div>
            <div class="form-group"><label>Email</label><input type="email" name="Email" required /></div>
            <div class="form-group"><label>Message</label><textarea name="Message" required></textarea></div>
            <button type="submit" class="btn-send">📨 Send</button>
            @if (Model.Sent) { <div class="msg">Your message has been received. Thank you!</div> }
        </form>
    </div>
</div>
</body>
</html>
