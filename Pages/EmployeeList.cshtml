@page
@model EmployeeListModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>EWTA - Employee List</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f0f2f5; margin: 0; }
        .header { background: #003366; color: white; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
        .header h1 { margin: 0; font-size: 20px; }
        .header a { color: white; text-decoration: none; background: #555; padding: 8px 16px; border-radius: 4px; }
        .container { max-width: 1100px; margin: 30px auto; padding: 0 20px; }
        .filter-box { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 20px; display: flex; gap: 16px; align-items: flex-end; }
        .filter-box label { font-weight: bold; display: block; margin-bottom: 4px; }
        .filter-box select { padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
        .filter-box button { background: #003366; color: white; padding: 8px 20px; border: none; border-radius: 4px; cursor: pointer; }
        table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        th { background: #003366; color: white; padding: 12px; text-align: left; font-size: 14px; }
        td { padding: 10px 12px; border-bottom: 1px solid #eee; font-size: 14px; }
        tr:hover td { background: #f5f8ff; }
        .badge { padding: 3px 8px; border-radius: 12px; font-size: 12px; }
        .active { background: #d4edda; color: #155724; }
        .inactive { background: #f8d7da; color: #721c24; }
        .total { background: white; padding: 12px 20px; border-radius: 8px; margin-top: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); color: #333; font-weight: bold; }
    </style>
</head>
<body>
    <div class="header">
        <h1>📋 Employee List</h1>
        <a href="/">← Main Menu</a>
    </div>
    <div class="container">
        <div class="filter-box">
            <div>
                <label>Filter by Department</label>
                <select id="deptFilter" onchange="filterTable()">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Value">@d.Value</option>
                    }
                </select>
            </div>
        </div>
        <table id="empTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Department</th>
                    <th>Title</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Start Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Employees)
                {
                    <tr>
                        <td>@e.EmplID</td>
                        <td>@e.FullName</td>
                        <td>@e.Department</td>
                        <td>@e.Title</td>
                        <td>@e.Email</td>
                        <td>@e.Phone</td>
                        <td>@e.StartDate</td>
                        <td><span class="badge @(e.IsActive ? "active" : "inactive")">@(e.IsActive ? "Active" : "Inactive")</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="total">Total Employees: @Model.Employees.Count</div>
    </div>
    <script>
        function filterTable() {
            var filter = document.getElementById("deptFilter").value.toLowerCase();
            var rows = document.querySelectorAll("#empTable tbody tr");
            rows.forEach(function(row) {
                var dept = row.cells[2].textContent.toLowerCase();
                row.style.display = (!filter || dept.includes(filter)) ? "" : "none";
            });
        }
    </script>
</body>
</html>