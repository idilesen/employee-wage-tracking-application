@page
@model EmployeeEntryModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>EWTA - Employee Entry</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f0f2f5; margin: 0; }
        .header { background: #003366; color: white; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
        .header h1 { margin: 0; font-size: 20px; }
        .header a { color: white; text-decoration: none; background: #555; padding: 8px 16px; border-radius: 4px; }
        .container { max-width: 700px; margin: 30px auto; background: white; padding: 32px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h2 { color: #003366; margin-bottom: 24px; }
        .form-group { margin-bottom: 16px; }
        label { display: block; font-weight: bold; margin-bottom: 4px; color: #333; }
        input[type=text], input[type=date], input[type=email], select {
            width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;
        }
        .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .radio-group { display: flex; gap: 16px; margin-top: 4px; }
        button { background: #003366; color: white; padding: 12px 32px; border: none; border-radius: 4px; font-size: 15px; cursor: pointer; margin-top: 8px; }
        button:hover { background: #0055aa; }
        .msg { margin-top: 16px; padding: 12px; border-radius: 4px; }
        .success { background: #d4edda; color: #155724; }
        .error { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body>
    <div class="header">
        <h1>👤 Employee Data Entry</h1>
        <a href="/">← Main Menu</a>
    </div>
    <div class="container">
        <h2>New Employee</h2>
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="form-group">
                    <label>First Name *</label>
                    <input type="text" name="FName" required />
                </div>
                <div class="form-group">
                    <label>Last Name *</label>
                    <input type="text" name="LName" required />
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    <label>Birth Date</label>
                    <input type="date" name="BDate" />
                </div>
                <div class="form-group">
                    <label>Start Date</label>
                    <input type="date" name="StartDate" />
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    <label>Gender</label>
                    <div class="radio-group">
                        <label><input type="radio" name="GenderID" value="1" checked /> Man</label>
                        <label><input type="radio" name="GenderID" value="2" /> Woman</label>
                    </div>
                </div>
                <div class="form-group">
                    <label>Title</label>
                    <select name="TitleID">
                        @foreach (var t in Model.Titles)
                        {
                            <option value="@t.Key">@t.Value</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    <label>Department</label>
                    <select name="DeptID">
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Key">@d.Value</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="Email" />
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    <label>Phone</label>
                    <input type="text" name="Phone" />
                </div>
                <div class="form-group">
                    <label>Cell</label>
                    <input type="text" name="Cell" />
                </div>
            </div>
            <div class="row">
            <div class="form-group">
                <label>City</label>
                <select name="City">
                    @foreach (var c in Model.Cities)
                    {
                        <option value="@c.Value">@c.Value</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Province</label>
                <select name="Province">
                    @foreach (var p in Model.Provinces)
                    {
                        <option value="@p.Value">@p.Value</option>
                    }
                </select>
            </div>
            </div>
            <div class="form-group">
                <label>Address</label>
                <input type="text" name="Address" />
            </div>
            <div class="form-group">
                <label>CV Info</label>
                <textarea name="CVInfo" rows="5" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; box-sizing:border-box; resize:vertical;"></textarea>
            </div>
            <div class="form-group">
                <label><input type="checkbox" name="IsActive" value="true" checked /> Active Employee</label>
            </div>
            <button type="submit">💾 Save Employee</button>
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="msg @(Model.Success ? "success" : "error")">@Model.Message</div>
            }
        </form>
    </div>
</body>
</html>