@page
@model WageGraphEmpModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>EWTA - Wage Graph by Employee</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: Arial, sans-serif; background: #f0f2f5; margin: 0; }
        .header { background: #003366; color: white; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
        .header h1 { margin: 0; font-size: 20px; }
        .header a { color: white; text-decoration: none; background: #555; padding: 8px 16px; border-radius: 4px; }
        .container { max-width: 900px; margin: 30px auto; padding: 0 20px; }
        .card { background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 24px; }
        h2 { color: #003366; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background: #003366; color: white; padding: 10px 12px; text-align: left; font-size: 13px; }
        td { padding: 9px 12px; border-bottom: 1px solid #eee; font-size: 13px; }
        tr:hover td { background: #f5f8ff; }
    </style>
</head>
<body>
<div class="header">
    <h1>📈 Wage Graph by Employee</h1>
    <a href="/">← Main Menu</a>
</div>
<div class="container">
    <div class="card">
        <h2>Total Wages per Employee</h2>
        <canvas id="empChart" height="100"></canvas>
    </div>
    <div class="card">
        <h2>Data Table</h2>
        <table>
            <thead><tr><th>Employee</th><th>Total Wages</th></tr></thead>
            <tbody>
                @foreach (var row in Model.EmployeeData)
                {
                    <tr><td>@row.Key</td><td>@row.Value.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script>
    var colors = ['rgba(0,51,102,0.7)','rgba(204,0,0,0.7)','rgba(40,167,69,0.7)','rgba(255,193,7,0.7)','rgba(0,123,255,0.7)'];
    var labels = [@Html.Raw(string.Join(",", Model.EmployeeData.Keys.Select(k => $"'{k}'")))];
    var data = [@Html.Raw(string.Join(",", Model.EmployeeData.Values.Select(v => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))))];
    new Chart(document.getElementById('empChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Total Wages',
                data: data,
                backgroundColor: colors.slice(0, labels.length),
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });
</script>
</body>
</html>
