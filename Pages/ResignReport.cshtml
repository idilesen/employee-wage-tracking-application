@page
@model ResignReportModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>EWTA - Employee Resign Report</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f0f2f5; margin: 0; }
        .header { background: #003366; color: white; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
        .header h1 { margin: 0; font-size: 20px; }
        .header a { color: white; text-decoration: none; background: #555; padding: 8px 16px; border-radius: 4px; }
        .container { max-width: 1000px; margin: 30px auto; padding: 0 20px; }
        .summary { background: white; padding: 16px 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 20px; display: flex; gap: 30px; }
        .summary-item .num { font-size: 28px; font-weight: bold; color: #cc0000; }
        .summary-item .lbl { font-size: 12px; color: #666; }
        table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        th { background: #003366; color: white; padding: 10px 12px; text-align: left; font-size: 13px; }
        td { padding: 9px 12px; border-bottom: 1px solid #eee; font-size: 13px; }
        tr:hover td { background: #f5f8ff; }
        .no-data { background: white; padding: 40px; text-align: center; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); color: #888; font-size: 15px; }
    </style>
</head>
<body>
<div class="header">
    <h1>🚪 Employee Resign Report</h1>
    <a href="/">← Main Menu</a>
</div>
<div class="container">
    <div class="summary">
        <div class="summary-item"><div class="num">@Model.ResignedEmployees.Count</div><div class="lbl">Resigned Employees</div></div>
    </div>

    @if (Model.ResignedEmployees.Count == 0)
    {
        <div class="no-data">No resigned employees found.</div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>ID</th><th>Full Name</th><th>Department</th><th>Start Date</th><th>Left Date</th><th>Reason</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.ResignedEmployees)
                {
                    <tr>
                        <td>@e.EmplID</td>
                        <td>@e.FullName</td>
                        <td>@e.Department</td>
                        <td>@e.StartDate</td>
                        <td>@e.LeftDate</td>
                        <td>@e.LeftReason</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
</body>
</html>
