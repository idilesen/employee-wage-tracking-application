@page
@model WizardFormModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>EWTA - Employee Wizard</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f0f2f5; margin: 0; }
        .header { background: #003366; color: white; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
        .header h1 { margin: 0; font-size: 20px; }
        .header a { color: white; text-decoration: none; background: #555; padding: 8px 16px; border-radius: 4px; }
        .container { max-width: 700px; margin: 30px auto; background: white; padding: 32px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .steps { display: flex; margin-bottom: 30px; }
        .step { flex: 1; text-align: center; padding: 10px; border-bottom: 3px solid #ddd; color: #aaa; font-size: 13px; font-weight: bold; }
        .step.active { border-color: #003366; color: #003366; }
        .step.done { border-color: #28a745; color: #28a745; }
        h2 { color: #003366; margin-bottom: 20px; }
        .form-group { margin-bottom: 14px; }
        label { display: block; font-weight: bold; margin-bottom: 4px; color: #333; font-size: 13px; }
        input[type=text], input[type=date], input[type=email], input[type=number], select {
            width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;
        }
        .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .radio-group { display: flex; gap: 16px; margin-top: 4px; }
        .wizard-step { display: none; }
        .wizard-step.active { display: block; }
        .btn-next { background: #003366; color: white; padding: 10px 28px; border: none; border-radius: 4px; font-size: 14px; cursor: pointer; }
        .btn-prev { background: #888; color: white; padding: 10px 20px; border: none; border-radius: 4px; font-size: 14px; cursor: pointer; margin-right: 10px; }
        .btn-save { background: #28a745; color: white; padding: 10px 28px; border: none; border-radius: 4px; font-size: 14px; cursor: pointer; }
        .nav-buttons { margin-top: 20px; display: flex; justify-content: space-between; align-items: center; }
        .msg { margin-top: 14px; padding: 10px; border-radius: 4px; }
        .success { background: #d4edda; color: #155724; }
        .error { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body>
<div class="header">
    <h1>🪄 Employee Data Entry Wizard</h1>
    <a href="/">← Main Menu</a>
</div>
<div class="container">
    <div class="steps">
        <div class="step active" id="step-indicator-1">1. Personal Info</div>
        <div class="step" id="step-indicator-2">2. Work Info</div>
        <div class="step" id="step-indicator-3">3. Contact Info</div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="msg @(Model.Success ? "success" : "error")">@Model.Message</div>
    }

    <form method="post" id="wizardForm">
        @Html.AntiForgeryToken()

        <div class="wizard-step active" id="step1">
            <h2>Step 1: Personal Information</h2>
            <div class="row">
                <div class="form-group"><label>First Name *</label><input type="text" name="FName" id="FName" required /></div>
                <div class="form-group"><label>Last Name *</label><input type="text" name="LName" id="LName" required /></div>
            </div>
            <div class="row">
                <div class="form-group"><label>Birth Date</label><input type="date" name="BDate" /></div>
                <div class="form-group">
                    <label>Gender</label>
                    <div class="radio-group">
                        <label><input type="radio" name="GenderID" value="1" checked /> Man</label>
                        <label><input type="radio" name="GenderID" value="2" /> Woman</label>
                    </div>
                </div>
            </div>
            <div class="nav-buttons">
                <span></span>
                <button type="button" class="btn-next" onclick="nextStep(1)">Next →</button>
            </div>
        </div>

        <div class="wizard-step" id="step2">
            <h2>Step 2: Work Information</h2>
            <div class="row">
                <div class="form-group">
                    <label>Department</label>
                    <select name="DeptID">
                        @foreach (var d in Model.Departments)
                        { <option value="@d.Key">@d.Value</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label>Title</label>
                    <select name="TitleID">
                        @foreach (var t in Model.Titles)
                        { <option value="@t.Key">@t.Value</option> }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="form-group"><label>Start Date</label><input type="date" name="StartDate" /></div>
                <div class="form-group"><label>Wage</label><input type="number" name="Wage" value="0" step="0.01" /></div>
            </div>
            <div class="row">
                <div class="form-group"><label>Commission Rate</label><input type="number" name="CommissionRate" value="0" step="0.01" /></div>
                <div class="form-group" style="padding-top:22px">
                    <label><input type="checkbox" name="IsActive" value="true" checked /> Active Employee</label>
                </div>
            </div>
            <div class="nav-buttons">
                <button type="button" class="btn-prev" onclick="prevStep(2)">← Back</button>
                <button type="button" class="btn-next" onclick="nextStep(2)">Next →</button>
            </div>
        </div>

        <div class="wizard-step" id="step3">
            <h2>Step 3: Contact Information</h2>
            <div class="row">
                <div class="form-group"><label>Email</label><input type="email" name="Email" /></div>
                <div class="form-group"><label>Phone</label><input type="text" name="Phone" /></div>
            </div>
            <div class="row">
                <div class="form-group"><label>Cell</label><input type="text" name="Cell" /></div>
                <div class="form-group"><label>City</label><input type="text" name="City" /></div>
            </div>
            <div class="row">
                <div class="form-group"><label>Province</label><input type="text" name="Province" /></div>
                <div class="form-group"><label>Address</label><input type="text" name="Address" /></div>
            </div>
            <div class="nav-buttons">
                <button type="button" class="btn-prev" onclick="prevStep(3)">← Back</button>
                <button type="submit" class="btn-save">✅ Save Employee</button>
            </div>
        </div>
    </form>
</div>
<script>
    var currentStep = 1;
    function nextStep(step) {
        if (step === 1) {
            var fn = document.getElementById('FName').value;
            var ln = document.getElementById('LName').value;
            if (!fn || !ln) { alert('Please fill in First Name and Last Name.'); return; }
        }
        document.getElementById('step' + step).classList.remove('active');
        document.getElementById('step-indicator-' + step).classList.remove('active');
        document.getElementById('step-indicator-' + step).classList.add('done');
        currentStep = step + 1;
        document.getElementById('step' + currentStep).classList.add('active');
        document.getElementById('step-indicator-' + currentStep).classList.add('active');
    }
    function prevStep(step) {
        document.getElementById('step' + step).classList.remove('active');
        document.getElementById('step-indicator-' + step).classList.remove('active');
        currentStep = step - 1;
        document.getElementById('step' + currentStep).classList.add('active');
        document.getElementById('step-indicator-' + currentStep).classList.remove('done');
        document.getElementById('step-indicator-' + currentStep).classList.add('active');
    }
</script>
</body>
</html>
